{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\qq504\\Desktop\\人工智能学习\\claude_code\\iGamePet\\lcd_display.py\" play _idle",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\qq504\\Desktop\\人工智能学习\\claude_code\\iGamePet\\lcd_display.py\" play _working",
